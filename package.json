{
  "name": "opencard-db",
  "version": "0.4.2",
  "private": true,
  "description": "Open-source structured credit card product metadata (CN/US/CA) with schema, PR contributions, and Cloudflare Workers API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "bun scripts/validate.ts",
    "coverage:check": "bun scripts/coverage-check.ts",
    "typecheck": "tsc --noEmit && bun run --cwd worker typecheck",
    "new:card": "bun scripts/new-card.ts",
    "build:indexes": "bun scripts/build-indexes.ts",
    "build:exports": "bun scripts/build-exports.ts",
    "optimize:images": "bun scripts/optimize-images.ts",
    "triage:pr": "bun scripts/run-pr-triage.ts",
    "triage:base-cards": "bun scripts/build-base-cards.ts",
    "find:stale-cards": "bun scripts/find-stale-cards.ts",
    "embed:default-card": "bun scripts/embed-default-card.ts",
    "opencard-export": "node packages/opencard-export/bin/opencard-export.mjs",
    "test": "bun test && npm --prefix packages/opencard-export test",
    "worker:dev": "bun run --cwd worker dev",
    "worker:deploy": "bun run --cwd worker deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "opencard-export": "file:packages/opencard-export",
    "release-please": "17.6.0",
    "typescript": "^7.0.2"
  }
}

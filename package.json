{
  "name": "opencard-db",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source structured credit card product metadata (CN/US/CA) with schema, PR contributions, and Cloudflare Workers API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "build:indexes": "node --experimental-strip-types scripts/build-indexes.ts",
    "test": "node --experimental-strip-types --test tests/schema/schema.test.ts tests/indexes/indexes.test.ts tests/api/api.contract.test.ts tests/api/card-image.test.ts",
    "embed:default-card": "node --experimental-strip-types scripts/embed-default-card.ts",
    "worker:dev": "npm run dev --prefix worker",
    "worker:deploy": "npm run deploy --prefix worker",
    "clues:wishlist": "node --experimental-strip-types scripts/clues/build-wishlist.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  }
}
